{
  "auto_discover": true,
  "defaults": {
    "runtime": "openclaw",
    "max_session_turns": 6,
    "max_prompt_chars": 6000
  },
  "agents": [
    {
      "agent_name": "assistant",
      "runtime": "openclaw"
    },
    {
      "agent_name": "reviewer",
      "runtime": "custom",
      "command": [
        "hermes",
        "run",
        "--session",
        "{session_id}",
        "--message",
        "{message}"
      ]
    }
  ]
}
